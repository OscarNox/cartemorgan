{
  "entities": {
    "Photo": {
      "title": "Photo",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "uploadedByUserId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Card": {
      "title": "Card",
      "type": "object",
      "properties": {
        "coverImage": { "type": "string" },
        "pdfDataUri": { "type": "string" },
        "uploadedByUserId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/photos/{photoId}": {
      "schema": "Photo",
      "description": "Colección raíz de fotografías compartidas."
    },
    "/cards/{cardId}": {
      "schema": "Card",
      "description": "Colección raíz de cartas y documentos PDF."
    }
  }
}