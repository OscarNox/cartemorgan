rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * REGLAS DE SEGURIDAD - CARTE MORGAN
     * 
     * 1. Lectura Pública: Todos pueden ver las fotos y cartas (espectadores).
     * 2. Escritura Restringida: Solo el administrador (aidaluxmorgan@gmail.com) 
     *    puede subir, editar o borrar contenido.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'aidaluxmorgan@gmail.com';
    }

    // Reglas para la galería de fotos
    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reglas para el baúl de cartas
    match /cards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reglas para perfiles de usuario (si se llegaran a usar en el futuro)
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}