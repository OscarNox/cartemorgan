rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY:
     * Solo el usuario administrador (aidaluxmorgan@gmail.com) tiene permisos de escritura.
     * El resto de los usuarios solo pueden leer el contenido (espectadores).
     */

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "aidaluxmorgan@gmail.com";
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}