
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Verificación del email de administración (normalizado a minúsculas)
      let email = request.auth.token.email.lower();
      return isSignedIn() && (email == 'aidaluxmorgan@gmail.com' || email == 'aidaluxmorgan');
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
